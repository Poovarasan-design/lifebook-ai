# ==============================================================================
# LifeBook AI — Environment Configuration
# ==============================================================================

# Core Settings
PROJECT_NAME="LifeBook AI"
API_V1_STR="/api/v1"

# Database Configuration
# Default zero-configuration SQLite for local hackathon demo:
DATABASE_URL="sqlite:///./lifebook.db"
# Optional PostgreSQL + pgvector for production / Docker:
# DATABASE_URL="postgresql://lifebook:lifebook_secret@localhost:5432/lifebook"

# Authentication & Security
SECRET_KEY="lifebook-super-secret-jwt-key-for-hackathon-2026"
JWT_SECRET_KEY="lifebook-super-secret-jwt-key-for-hackathon-2026"
ALGORITHM="HS256"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_EXPIRE_MINUTES=10080

# Google OAuth 2.0 (Google Sign-In)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"
# Frontend Google Client ID
VITE_GOOGLE_CLIENT_ID=""

# Storage
STORAGE_DIR="./storage"

# AI Provider Configuration ("local", "openai", "gemini")
# "local" works 100% out of the box with zero API keys required
AI_PROVIDER="local"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Speech-to-Text Provider ("local", "whisper")
STT_PROVIDER="local"

# Demo Account Credentials (populated via database/seed_demo.py)
DEMO_NAME="Jothiram"
DEMO_EMAIL="jothiram@lifebook.ai"
DEMO_PASSWORD="LifeBook2026!"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
